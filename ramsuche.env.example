# RAM-Suche (python -m ramsuche lauf). Kopieren nach ramsuche.env; alles ist optional.

# Handy-Meldungen über ntfy. Leer = Thema aus copilot.env verwenden (dort schon abonniert).
NTFY_TOPIC=
NTFY_SERVER=

# eBay nur mit eigenen Schlüsseln: developer.ebay.com -> Konto -> Application Keys -> Production
# (App ID = Client ID, Cert ID = Client Secret). Leer = eBay aus, nur Kleinanzeigen.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Kategorie "Speicher (RAM)"; leer = ohne Kategorie (dann filtert nur die Titelerkennung)
EBAY_KATEGORIE=170083
# Artikelstandort (Ländercode); leer = alle Länder
EBAY_LAENDER=DE

# Mindestgröße gesamt und je Riegel (32 / 16 = 2x16 GB oder 1x32 GB und größer)
MIN_GB=32
MIN_RIEGEL_GB=16
# Schnäppchen = mindestens so weit unter dem gemessenen Marktpreis (0.30 = 30 %)
RABATT=0.30
# Zusätzlich alles melden, was höchstens so viel Euro pro GB kostet (leer = aus)
MAX_EUR_PRO_GB=
# Kleinanzeigen-Seiten je Lauf (27 Anzeigen pro Seite); bitte klein halten
KA_SEITEN=3
# eBay-Auktionen erst melden, wenn sie in so vielen Stunden enden
AUKTION_STUNDEN=2
# Grobe Weiterverkaufsrechnung: Abschlag auf Marktpreis und eigener Versand
ABSCHLAG_VERKAUF=0.10
VERSAND_VERKAUF=7
MAX_MELDUNGEN=5
