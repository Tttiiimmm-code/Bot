# Alpaca API-Zugangsdaten (kostenloses Paper-Trading-Konto: https://alpaca.markets)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true/1/yes = Paper-Trading (Simulation, kein echtes Geld), false/0/no = Live-Trading.
# Jeder andere Wert (z.B. ein Tippfehler) wird als Fehler abgelehnt statt
# stillschweigend als Live-Trading interpretiert zu werden.
ALPACA_PAPER=true

# Handelsparameter
SYMBOL=AAPL
QTY=1
SHORT_WINDOW=20
LONG_WINDOW=50
POLL_INTERVAL_SECONDS=60

# Trailing-Stop als Anteil unter dem Höchststand seit Einstieg, z.B. 0.08 = 8%. 0 deaktiviert den Stop.
STOP_LOSS_PCT=0.08

# Take-Profit als Anteil über dem Einstiegspreis, z.B. 0.15 = 15%. 0 deaktiviert.
TAKE_PROFIT_PCT=0.15

# Kapitalrisiko pro Trade (nur wirksam mit STOP_LOSS_PCT > 0), z.B. 0.02 = 2%.
# 0 = volles Kapital pro Trade / feste QTY (siehe README für die Kompromisse).
RISK_PER_TRADE_PCT=0.0

# Trendfilter: BUY nur, wenn der Kurs über dieser SMA liegt. 0 deaktiviert.
TREND_FILTER_WINDOW=200

# RSI-Filter: BUY nur, wenn der RSI über 50 liegt. 0 deaktiviert.
RSI_WINDOW=14
