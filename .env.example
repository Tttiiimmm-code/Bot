# Alpaca API-Zugangsdaten (kostenloses Paper-Trading-Konto: https://alpaca.markets)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# true = Paper-Trading (Simulation, kein echtes Geld), false = Live-Trading
ALPACA_PAPER=true

# Handelsparameter
SYMBOL=AAPL
QTY=1
SHORT_WINDOW=20
LONG_WINDOW=50
POLL_INTERVAL_SECONDS=60
