[Unit]
Description=Tradingbot (Alpaca Moving-Average-Crossover, Paper-Trading)
After=network-online.target
Wants=network-online.target
# Verhindert ein Crash-Loop bei einem dauerhaft falsch konfigurierten Start
# (z.B. fehlende .env): nach 5 Neustarts in 10 Minuten hält systemd an,
# statt endlos alle 30s neu zu versuchen.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Anpassen: eigener, nicht-root Linux-User + absoluter Pfad zum Repo auf dem VPS.
User=tradingbot
WorkingDirectory=/home/tradingbot/Bot
ExecStart=/home/tradingbot/Bot/.venv/bin/python main.py run

# .env liegt im Repo und wird von python-dotenv beim Start automatisch geladen
# (siehe tradingbot/config.py) -- kein zusätzliches EnvironmentFile nötig.

Restart=on-failure
RestartSec=30

# Kein Netzwerkzugriff auf lokale Dienste nötig, keine Schreibrechte
# außerhalb des Arbeitsverzeichnisses (Logs gehen an journald, nicht in
# eine Datei im Repo).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/tradingbot/Bot

[Install]
WantedBy=multi-user.target
