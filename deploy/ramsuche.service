[Unit]
Description=RAM-Suche: günstigen DDR5-RAM auf Kleinanzeigen/eBay finden und per ntfy melden (kauft nichts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradingbot
WorkingDirectory=/home/tradingbot/Bot
ExecStart=/home/tradingbot/Bot/.venv/bin/python -m ramsuche lauf
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=600
MemoryMax=300M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/tradingbot/Bot
